# ==========================================
# ReVoice Server Configuration (.env)
# ==========================================

# Google Gemini API Key (Translation & Dubbing Adaptation)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Groq API Key (High-Speed Whisper Audio Transcription)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=whisper-large-v3-turbo

# Fish Audio API Key (Voice Cloning & TTS Generation)
# Get from: https://fish.audio/
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here

# Port (default 3000)
PORT=3000
